{
  "expo": {
    "name": "Atlasys",
    "slug": "atlasys",
    "version": "1.8.7",
    "orientation": "portrait",
    "icon": "assets/images/icons/adaptive-icon.png",
    "scheme": "atlasys",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cactus-apps.Atlasys",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID is used to unlock the live location view when location sharing is active."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/images/icons/adaptive-icon.png",
        "monochromeImage": "assets/images/icons/adaptive-icon.png",
        "backgroundColor": "#DDDDDD"
      },
      "package": "com.cactus_apps.Atlasys",
      "versionCode": 36,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "atlasys"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "assets/images/icon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "cactus-apps"
        }
      ],
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sqlite",
      "@sentry/react-native",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera permission is required to scan family pairing codes."
        }
      ],
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atlasys uses location so your family can see where you are while live sharing is active.",
          "locationAlwaysAndWhenInUsePermission": "Atlasys uses background location so your family can keep seeing your position after you leave the app.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "753eb474-331e-49f0-a5a9-fa0d2431fe5e"
      }
    },
    "runtimeVersion": "3",
    "updates": {
      "url": "https://u.expo.dev/753eb474-331e-49f0-a5a9-fa0d2431fe5e"
    },
    "owner": "helloworld127"
  }
}
