  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');['react-native-webview','expo-asset'].forEach(mod=>{const d=p.join('node_modules/react-native-maplibre-gl-js/node_modules',mod);if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Removed nested '+mod)}});const dndPkg=p.join('node_modules/react-native-reanimated-dnd/package.json');if(fs.existsSync(dndPkg)){const pkg=JSON.parse(fs.readFileSync(dndPkg,'utf8'));if(pkg.exports){delete pkg.exports;fs.writeFileSync(dndPkg,JSON.stringify(pkg,null,2)+'\\n');console.log('Fixed react-native-reanimated-dnd exports')}}\""
  },
