{
  "version": 8,
  "name": "Google Maps Style",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F1EFE6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#A2D4E0" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#A2D4E0",
        "line-width": 1
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": { "fill-color": "#D9E8C8" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#B5D6A5" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": { "fill-color": "#C8E6C9" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#ECE8DD" }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "commercial"],
      "paint": { "fill-color": "#E8E3D8" }
    },
    {
      "id": "landuse-industrial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "industrial"],
      "paint": { "fill-color": "#E0DCD0" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#D5D0C8",
        "fill-outline-color": "#C4BFB8"
      }
    },
    {
      "id": "highway-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "paint": {
        "line-color": "#D0C8BC",
        "line-width": 1,
        "line-dasharray": [1, 1]
      }
    },
    {
      "id": "highway-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 2
      }
    },
    {
      "id": "highway-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#FFF2B2",
        "line-width": 3
      }
    },
    {
      "id": "highway-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#FFCD5E",
        "line-width": 4
      }
    },
    {
      "id": "highway-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "paint": {
        "line-color": "#FF8C00",
        "line-width": 5
      }
    },
    {
      "id": "highway-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#F97316",
        "line-width": 3
      },
      "maxzoom": 24,
      "minzoom": 4
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {
        "line-color": "#A09A90",
        "line-width": 2,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "transit-subway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "transit"],
      "paint": {
        "line-color": "#6B6390",
        "line-width": 2
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#B8B0A8",
        "line-width": 1
      }
    },
    {
      "id": "poi_transit",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["==", "class", "transit"],
      "minzoom": 14,
      "layout": {
        "icon-image": "poi_transit",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#336699",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_eating",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "eating", "restaurant", "fast_food", "cafe"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_eating",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#E85D3A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_shopping",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "shop", "mall", "supermarket"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_shopping",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#E98B2E",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_accommodation",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "hotel", "motel", "hostel", "lodging"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_accommodation",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#4A6FA5",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_attractions",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "attraction", "museum", "monument", "artwork", "castle"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_attractions",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#8B5CF6",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_nightlife",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "bar", "pub", "nightclub"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_nightlife",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#D946EF",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_education",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "school", "university", "college", "library"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_education",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#0097A7",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_medical",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "hospital", "pharmacy", "clinic", "doctor"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_medical",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#D32F2F",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_fuel",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["==", "class", "fuel"],
      "minzoom": 15,
      "layout": {
        "icon-image": "poi_fuel",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#4CAF50",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_parking",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["in", "class", "parking"],
      "minzoom": 16,
      "layout": {
        "icon-image": "poi_parking",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#5C6BC0",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["!in", "class", "transit", "eating", "restaurant", "fast_food", "cafe", "shop", "mall", "supermarket", "hotel", "motel", "hostel", "lodging", "attraction", "museum", "monument", "artwork", "castle", "bar", "pub", "nightclub", "school", "university", "college", "library", "hospital", "pharmacy", "clinic", "doctor", "fuel", "parking"],
      "minzoom": 16,
      "layout": {
        "icon-image": "poi_other",
        "icon-size": 0.5,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "highway-name-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "minor", "service"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 10,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#777777",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "highway-name-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "primary", "secondary", "tertiary"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 12,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "suburb"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#888888",
        "text-halo-color": "#F1EFE6",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "town", "village"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 13,
        "text-font": ["Noto Sans Bold"]
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#F1EFE6",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 16,
        "text-font": ["Noto Sans Bold"]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#F1EFE6",
        "text-halo-width": 2
      }
    }
  ],
  "id": "google-style"
}
